      "id": "f726c720-f609-4b63-a235-0e68317eabcb",
      "name": "Google Gemini Chat Model"
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const message = item.json.chatInput || \"\";\n\n  const documentMatch = message.match(\n    /Document:\\s*(.+)/i\n  );\n\n  const questionMatch = message.match(\n    /Question:\\s*([\\s\\S]+)/i\n  );\n\n  return {\n    json: {\n      ...item.json,\n      document_title: documentMatch\n        ? documentMatch[1].trim()\n        : \"\",\n      chatInput: questionMatch\n        ? questionMatch[1].trim()\n        : message.trim()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
